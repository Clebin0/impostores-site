# Development Environment Variables
# Copy this file to .env.local and fill in the values

# Site Configuration
NEXT_PUBLIC_SITE_NAME=IMPOSTORES
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social Media
NEXT_PUBLIC_INSTAGRAM_USERNAME=impostoresa
NEXT_PUBLIC_WHATSAPP_NUMBER=REMOVED_FROM_PUBLIC_HISTORY

# PIX Configuration (Mockado para desenvolvimento)
NEXT_PUBLIC_PIX_KEY=REMOVED_FROM_PUBLIC_HISTORY
PIX_SECRET_KEY=REMOVED_FROM_PUBLIC_HISTORY

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CHEERS_API_URL=https://api.cheers.app

# Analytics (Opcional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTAG_ID=

# Stripe (Futuro)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Database (Futuro)
# DATABASE_URL=postgresql://user:password@localhost:5432/impostores

# Authentication (Futuro)
# NEXTAUTH_SECRET=sua_secret_aqui
# NEXTAUTH_URL=http://localhost:3000
